{
  "name": "capitalone-hackmty",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "postinstall": "git config core.hooksPath .githooks || true",
    "dev": "bun run --filter '*' dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test --pass-with-no-tests",
    "build": "bun run --filter '*' build",
    "doctor": "bun run scripts/doctor.ts",
    "eval": "bun run scripts/eval.ts",
    "migrate": "bun run scripts/migrate.ts",
    "seed": "bun run scripts/seed.ts",
    "reset": "bun run scripts/reset.ts",
    "demo": "bun run scripts/demo.ts",
    "audit:web": "bun run apps/web/audit/audit.ts",
    "shoot:web": "bun run apps/web/brand/shoot.ts",
    "voice-setup": "bun run scripts/voice-setup.ts",
    "scrub": "bun run scripts/scrub.ts",
    "release-check": "bun run scripts/release-check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  }
}
