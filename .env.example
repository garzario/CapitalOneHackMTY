# Nessie sandbox key. Auth is the ?key= query parameter on https://api.nessieisreal.com, never a header.
NESSIE_API_KEY=
# Postgres connection string, for example postgres://postgres:postgres@localhost:5432/hackmty
DATABASE_URL=
# Google Gemini key, read by packages/extract. Without it POST /api/v1/instructions
# refuses an image or a voice note with 422 and everything else still works.
GEMINI_API_KEY=
# ElevenLabs key. Only needed if the voice integration actually lands.
ELEVENLABS_API_KEY=
# ElevenLabs conversational agent id. `bun run voice-setup` creates one and prints it.
ELEVENLABS_AGENT_ID=
# ElevenLabs telephone number id the outbound call dials from. Printed by voice-setup.
ELEVENLABS_PHONE_NUMBER_ID=
# Optional. Id of the Mexican Spanish voice; empty means the provider default.
ELEVENLABS_VOICE_ID=
# The SECOND ElevenLabs agent, the one the guided tour telephones a visitor with.
# `bun run voice-setup --owner` creates it from the same config and prints the id.
# An agent id names a configuration and authorises nothing, so it is not a secret.
# Empty means POST /api/v1/tour/call answers 422 carrying the script, and every
# other part of the tour still works.
ELEVENLABS_OWNER_AGENT_ID=
# set to 1 to let this instance telephone the number a visitor types into the tour.
# Off by default and deliberately opt-in: an endpoint that rings a real number on
# request is not something a deployment should acquire by accident. With it unset,
# POST /api/v1/tour/call answers 403 and GET /api/v1/tour says callsEnabled false.
ALLOW_TOUR_CALLS=
# How long a decision the tour applied stands before the line goes back to where
# the control had it, in milliseconds. Default 600000, ten minutes. Zero disables
# the revert, which is what a rehearsal wants when nobody is going to reload.
TOUR_REVERT_MS=
# How often the tour asks whether its call has finished, and how long it keeps
# asking, in milliseconds. Defaults 3000 and 180000. Either at zero means the
# endpoint places the call and starts no background work at all.
TOUR_POLL_INTERVAL_MS=
TOUR_POLL_DEADLINE_MS=
# Salt for the SHA-256 of the visitor's telephone number, which is the ONLY trace
# of that number this product keeps. CONSORTIUM_SALT wins when it is set, so a
# deployment that rotates one salt rotates this one with it, and the documented
# default in apps/api/src/routes/tour.ts applies when neither is set.
TOUR_SALT=
# Vultr, only on the deploy machine
VULTR_API_KEY=
# set to 1 to enable POST /api/v1/seed locally
ALLOW_SEED=
# set to 1 to let POST /api/v1/cep/verify reach the public Banxico CEP portal. Off by
# default: the portal is an undocumented form behind a CAPTCHA and a per-address rate
# limit, and the primary path in docs/09 is the clerk pasting the XML in `xml`.
ALLOW_CEP_FETCH=
# PEM of the Banxico certificate the CEP sello is checked against (\n escapes are fine).
# Without it a CEP keeps signatureReason "not_checked", which the UI shows as
# "firma no verificada" and never as invalid. Waiting on issue #57.
BANXICO_CEP_CERT_PEM=
# Which rail sends the 0.01 MXN verification: nessie or stp. Empty defaults to nessie when
# NESSIE_API_KEY is set and to no rail at all otherwise, and then
# POST /api/v1/instructions/:id/verify-account answers 503 naming these variables.
# nessie records the cent on the company's Nessie bank mirror: it proves the flow and is not
# a bank, so it produces no CEP. stp is the SPEI participant that does.
RAIL=
# STP, the production path. NAMES ONLY in this file: nothing in this repository holds an STP
# contract, so StpRail refuses to run and has never been live. The sandbox host STP documents
# is https://demo.stpmex.com:7024/speiws/rest and production is https://prod.stpmex.com:7024/speiws/rest.
STP_BASE_URL=
# The contracted empresa STP signs orders for.
STP_EMPRESA=
# The company's own CLABE at STP, the ordenante of the probe.
STP_CLABE_ORDENANTE=
# PATH on the production host to the private key of the certificate STP registered for the
# empresa. A path and never the key: the key does not enter this repository or this file.
STP_PRIVATE_KEY_PATH=
# How often the verification asks for the CEP of a cent that is out, in milliseconds.
# Default 3000. Zero turns the background poll off, which is what the test suite does.
CEP_POLL_INTERVAL_MS=
# How long it keeps asking before it hands the clave de rastreo back to the clerk.
# Default 60000. A SPEI settles in seconds and its CEP is published shortly after.
CEP_POLL_DEADLINE_MS=
# The deployed web. https://sentryone-one.vercel.app until sentryone.tech is registered (issue #59).
PUBLIC_WEB_URL=
# The deployed API. https://api.104.238.147.69.sslip.io, printed by bun run deploy:vultr.
PUBLIC_API_URL=
# Gemini model for extraction (verified 2026-09-12: gemini-2.5-flash is not available to new projects)
GEMINI_MODEL=gemini-3.6-flash
# --- The SentryOne consortium (Snowflake). See packages/consortium/README.md ---
# set to 1 to let the scripts and the API touch the cross-tenant network at all. Off by
# default: with it unset the engine reads the network as "not consulted" and every
# decision is the one this product made before the consortium existed.
ALLOW_CONSORTIUM=
# Snowflake org-account identifier, for example myorg-sentryone. Dots are replaced with
# hyphens in the JWT claim, and the host is <account>.snowflakecomputing.com.
SNOWFLAKE_ACCOUNT=
# The Snowflake user the key pair is registered on. Upper-cased inside the JWT claims.
SNOWFLAKE_USER=
# Path to the unencrypted PKCS8 PEM, OUTSIDE this repository. A path and never the PEM
# itself: a multi-line key in an .env is a key in a screenshot.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=SENTRYONE
SNOWFLAKE_SCHEMA=CONSORTIUM
# Network-wide salt for the (rfc, clabe) hashes. Empty falls back to the documented demo
# value in packages/consortium/src/hash.ts, which is what makes two laptops agree on the
# demo network. One salt for the whole network is deliberate: a per-tenant salt would make
# every row unjoinable and the consortium pointless. A rotation invalidates every stored
# hash on purpose.
CONSORTIUM_SALT=
