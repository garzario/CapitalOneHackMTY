# Nessie sandbox key. Auth is the ?key= query parameter on https://api.nessieisreal.com, never a header.
NESSIE_API_KEY=
# Postgres connection string, for example postgres://postgres:postgres@localhost:5432/hackmty
DATABASE_URL=
# Google Gemini key, read by packages/extract. Without it POST /api/v1/instructions
# refuses an image or a voice note with 422 and everything else still works.
GEMINI_API_KEY=
# ElevenLabs key. Only needed if the voice integration actually lands.
ELEVENLABS_API_KEY=
# ElevenLabs conversational agent id. `bun run voice-setup` creates one and prints it.
ELEVENLABS_AGENT_ID=
# ElevenLabs telephone number id the outbound call dials from. Printed by voice-setup.
ELEVENLABS_PHONE_NUMBER_ID=
# Optional. Id of the Mexican Spanish voice; empty means the provider default.
ELEVENLABS_VOICE_ID=
# Vultr, only on the deploy machine
VULTR_API_KEY=
# set to 1 to enable POST /api/v1/seed locally
ALLOW_SEED=
# set to 1 to let POST /api/v1/cep/verify reach the public Banxico CEP portal. Off by
# default: the portal is an undocumented form behind a CAPTCHA and a per-address rate
# limit, and the primary path in docs/09 is the clerk pasting the XML in `xml`.
ALLOW_CEP_FETCH=
# PEM of the Banxico certificate the CEP sello is checked against (\n escapes are fine).
# Without it a CEP keeps signatureReason "not_checked", which the UI shows as
# "firma no verificada" and never as invalid. Waiting on issue #57.
BANXICO_CEP_CERT_PEM=
# Which rail sends the 0.01 MXN verification: nessie or stp. Empty defaults to nessie when
# NESSIE_API_KEY is set and to no rail at all otherwise, and then
# POST /api/v1/instructions/:id/verify-account answers 503 naming these variables.
# nessie records the cent on the company's Nessie bank mirror: it proves the flow and is not
# a bank, so it produces no CEP. stp is the SPEI participant that does.
RAIL=
# STP, the production path. NAMES ONLY in this file: nothing in this repository holds an STP
# contract, so StpRail refuses to run and has never been live. The sandbox host STP documents
# is https://demo.stpmex.com:7024/speiws/rest and production is https://prod.stpmex.com:7024/speiws/rest.
STP_BASE_URL=
# The contracted empresa STP signs orders for.
STP_EMPRESA=
# The company's own CLABE at STP, the ordenante of the probe.
STP_CLABE_ORDENANTE=
# PATH on the production host to the private key of the certificate STP registered for the
# empresa. A path and never the key: the key does not enter this repository or this file.
STP_PRIVATE_KEY_PATH=
# How often the verification asks for the CEP of a cent that is out, in milliseconds.
# Default 3000. Zero turns the background poll off, which is what the test suite does.
CEP_POLL_INTERVAL_MS=
# How long it keeps asking before it hands the clave de rastreo back to the clerk.
# Default 60000. A SPEI settles in seconds and its CEP is published shortly after.
CEP_POLL_DEADLINE_MS=
# The deployed web. https://sentryone-one.vercel.app until sentryone.tech is registered (issue #59).
PUBLIC_WEB_URL=
# The deployed API. https://api.104.238.147.69.sslip.io, printed by bun run deploy:vultr.
PUBLIC_API_URL=
# Gemini model for extraction (verified 2026-09-12: gemini-2.5-flash is not available to new projects)
GEMINI_MODEL=gemini-3.6-flash
